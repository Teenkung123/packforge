#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Keep build and benchmark helper scripts out of GitHub's language breakdown.
# They remain tracked and syntax-highlighted; this only excludes them from the
# repository language percentages.
/gradlew         -linguist-detectable
/gradlew.bat     -linguist-detectable
scripts/*.sh     -linguist-detectable
scripts/*.ps1    -linguist-detectable
scripts/*.bat    -linguist-detectable
scripts/*.cmd    -linguist-detectable
