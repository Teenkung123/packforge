{
	"schemaVersion": 1,
	"id": "packforge",
	"version": "${version}",
	"name": "PackForge",
	"description": "Faster pack reloads and atlas overflow recovery for large resource packs.",
	"authors": [
		"Teenkung123"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/packforge/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.teenkung.packforge.fabric.PackForgeFabric"
		],
		"client": [
			"com.teenkung.packforge.fabric.PackForgeFabricClient"
		],
		"modmenu": [
			"com.teenkung.packforge.client.config.PackForgeModMenuApi"
		]
	},
	"mixins": [
		"packforge.fabric.mixins.json",
		{
			"config": "packforge.fabric.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "packforge.accesswidener",
	"depends": {
		"fabricloader": "${fabric_loader_dependency}",
		"minecraft": "${minecraft_dependency}",
		"java": "${java_dependency}",
		"fabric-api": "*"
	}
}
