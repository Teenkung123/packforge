{
	"required": true,
	"package": "com.teenkung.packforge.mixin",
	"plugin": "com.teenkung.packforge.QuickPackMixinPlugin",
	"compatibilityLevel": "JAVA_21",
	"mixins": [
		"loader.FilePackResourcesMixin",
		"loader.SharedZipFileAccessAccessor",
		"loader.SharedZipFileAccessMixin",
		"observe.ReloadableResourceManagerMixin",
		"observe.SimpleReloadInstanceMixin",
		"startup.UtilExecutorMixin"
	],
	"injectors": {
		"defaultRequire": 1
	},
	"overwrites": {
		"requireAnnotations": true
	}
}
